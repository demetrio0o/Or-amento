{
  "name": "orcamentos-a-fernandes",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicativo de orçamentos de serviço A Fernandes",
  "scripts": {
    "prepare:web": "node scripts/prepare-web.js",
    "pc": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@fontsource-variable/montserrat": "^5.1.0",
    "@fontsource-variable/public-sans": "^5.1.0",
    "jspdf": "2.5.1",
    "jspdf-autotable": "3.8.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "main": "electron/main.js",
  "author": "A Fernandes",
  "build": {
    "appId": "com.afernandes.orcamentos",
    "productName": "A Fernandes Orçamentos",
    "directories": {
      "output": "dist-pc",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Orcamentos-A-Fernandes-Instalador.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "language": "1046"
    }
  }
}
